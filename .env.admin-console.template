# -------------------------------
# Optional admin console app - standalone Next.js app for HR user
# management (user-manager role) and delegated client-admin group
# management (delegated-client-admin-base role). See admin-console/README.md.
# -------------------------------
ADMIN_CONSOLE_CLIENT_ID=hr-client-admin-console
ADMIN_CONSOLE_CLIENT_SECRET=change_admin_console_client_secret
ADMIN_CONSOLE_NEXTAUTH_SECRET=change_admin_console_nextauth_secret

# Realm served by this console. Keep this equal to the existing Keycloak
# KC_NEW_REALM_NAME; this exact value is also used as the public display name.
KC_NEW_REALM_NAME=change_realm_name

# Public URL of the admin-console app itself. Configure this same URL
# manually on the OIDC client redirect, logout, and web-origin settings;
# the runtime also uses it as NEXTAUTH_URL.
ADMIN_CONSOLE_APP_URL=http://localhost:3100
# Host port published by docker compose for the admin-console service.
ADMIN_CONSOLE_PORT=3100
# Host interface docker compose binds ADMIN_CONSOLE_PORT to. Defaults to
# 127.0.0.1 (loopback-only) - this app is an admin surface and must never be
# reachable directly from the public internet.
#   - nginx on this same docker host: leave the default (127.0.0.1).
#   - nginx on a separate host (e.g. a LAN-only reverse proxy, as opposed to
#     a public/global one): set this to this VM's ingress IP (a single-NIC
#     VM only has the one), then at the host firewall accept ADMIN_CONSOLE_PORT
#     only from that LAN nginx box's source IP and deny everyone else on that
#     port - including the global nginx, which reaches this same VM IP for
#     other services. The bind address alone is not access control once it's
#     not 127.0.0.1; the firewall source-IP rule is what actually restricts
#     it. See nginx-confs/hr-admin-console.conf.
#   - local dev without any reverse proxy: 0.0.0.0 is fine.
ADMIN_CONSOLE_BIND_IP=127.0.0.1

# Keycloak URL reachable from the end user's browser (login/logout redirects).
# In local dev this is the same host-published URL as KC_HOSTNAME would be in
# prod; in prod, point this at the public hostname (e.g. https://sso.example.com).
ADMIN_CONSOLE_KEYCLOAK_PUBLIC_URL=http://localhost:8080

# Next.js-owned extension database. Keep this separate from the Keycloak
# database even though both are hosted by the same PostgreSQL service.
ADMIN_CONSOLE_DB_NAME=sso_admin
ADMIN_CONSOLE_DB_USER=sso_admin_app
ADMIN_CONSOLE_DB_PASSWORD=change_admin_console_db_password
# URL-encode special characters in the password used in this connection URL.
ADMIN_CONSOLE_DATABASE_URL=postgresql://sso_admin_app:change_admin_console_db_password@postgres:5432/sso_admin

# Protected HRMS server-to-server API. These values are used only by Next.js
# route handlers and must never be prefixed with NEXT_PUBLIC_.
HRMS_API_URL=
HRMS_API_TOKEN=
HRMS_API_ROLE=user
HRMS_API_TIMEOUT_MS=10000
