# Copy to .env.local for running `npm run dev` outside docker compose.
# When running inside docker compose, these are supplied by the root .env
# file via docker-compose.yml instead - see the "Admin console app" section
# of .env.template at the repo root.

ADMIN_CONSOLE_KEYCLOAK_REALM=org-new-delhi
ADMIN_CONSOLE_CLIENT_ID=hr-client-admin-console
ADMIN_CONSOLE_CLIENT_SECRET=change_admin_console_client_secret

# Outside docker compose, Keycloak is reachable at the same URL for both the
# browser and this app's server process, so these are usually identical.
ADMIN_CONSOLE_KEYCLOAK_PUBLIC_URL=http://localhost:8080
ADMIN_CONSOLE_KEYCLOAK_INTERNAL_URL=http://localhost:8080

NEXTAUTH_SECRET=change_admin_console_nextauth_secret
NEXTAUTH_URL=http://localhost:3100

ADMIN_CONSOLE_USER_MANAGER_ROLE=user-manager
ADMIN_CONSOLE_DELEGATED_CLIENT_ADMIN_ROLE=delegated-client-admin-base
ADMIN_CONSOLE_APP_ROLES_GROUP_NAME=AppRoles
